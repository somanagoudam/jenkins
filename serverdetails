pipeline{
    agent any
    stages{
        stage('serverdetails'){
            steps{
             sh '''  
             echo "SERVER DETAILS"
             cat /etc/os-release
              '''
            }
        }
        stage('CPUdetails'){
            steps{
             sh '''
               echo "CPUdetails DETAILS"
               lscpu
                '''
            }
        }
        stage('RAM details'){
            steps{
             sh  '''
             echo "RAM DETAILS"
             cat /proc/meminfo
             '''
            }
        }
        stage('Diskdetails'){
            steps{
             sh '''
               echo "disk DETAILS"
               lsblk
               '''
            }
        }
        stage('WEB details'){
            steps{
                sh '''
                echo "web DETAILS"
                echo "hi"
                hostname -I 
                '''
            }
        }
    }
}
